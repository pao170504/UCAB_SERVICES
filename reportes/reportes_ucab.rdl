    <DataSet Name="ocupacion_estacionamiento">
      <Query>
        <DataSourceName>PostgreSQL_UCAB</DataSourceName>
        <CommandText>SELECT 
  se.nombre AS sede,
  z.nombre AS zona,
  pu.tipo_vehiculo,
  COUNT(pu.numero_puesto) AS total_puestos,
  COUNT(pu.numero_puesto) FILTER (WHERE pu.estado = 'Libre') AS libres,
  COUNT(pu.numero_puesto) FILTER (WHERE pu.estado = 'Ocupado') AS ocupados,
  COUNT(pu.numero_puesto) FILTER (WHERE pu.estado = 'Mantenimiento') AS en_mantenimiento,
  ROUND(COUNT(pu.numero_puesto) FILTER (WHERE pu.estado = 'Ocupado') * 100.0 / NULLIF(COUNT(pu.numero_puesto), 0), 2) AS tasa_ocupacion_pct
FROM Zona_Estacionamiento z
JOIN Sede se ON se.id_sede = z.id_sede
JOIN Puesto pu ON pu.id_zona = z.id_zona
WHERE pu.tipo_vehiculo IS NOT NULL
GROUP BY se.nombre, z.nombre, pu.tipo_vehiculo
ORDER BY se.nombre, z.nombre, pu.tipo_vehiculo</CommandText>
      </Query>
      <Fields>
        <Field Name="sede">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>sede</DataField>
        </Field>
        <Field Name="zona">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>zona</DataField>
        </Field>
        <Field Name="tipo_vehiculo">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>tipo_vehiculo</DataField>
        </Field>
        <Field Name="total_puestos">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>total_puestos</DataField>
        </Field>
        <Field Name="libres">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>libres</DataField>
        </Field>
        <Field Name="ocupados">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>ocupados</DataField>
        </Field>
        <Field Name="en_mantenimiento">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>en_mantenimiento</DataField>
        </Field>
        <Field Name="tasa_ocupacion_pct">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>tasa_ocupacion_pct</DataField>
        </Field>
      </Fields>
    </DataSet>
